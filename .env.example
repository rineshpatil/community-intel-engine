# Copy to .env and fill in. .env is gitignored; this file is not.
#   cp .env.example .env
#
# You do NOT need any of this to run the test suite or the smoke test —
# both are self-contained. This is only for pointing the code at real AWS.
#
# Precedence: a shell variable beats .env, so you can override one value
# for a single run without editing this file:
#   CIE_TABLE_NAME=other uv run python -m something

# --- Required ---------------------------------------------------------
# From `cdk deploy` outputs (TableName, QueueUrl).
CIE_TABLE_NAME=CommunityIntelIngestion-Items...
CIE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/...

# --- GitHub -----------------------------------------------------------
# Deployed, the Lambda reads the secret from SSM and ignores the plain
# value below. Locally, leave the PARAM empty and set the plain secret.
CIE_GITHUB_WEBHOOK_SECRET=
CIE_GITHUB_WEBHOOK_SECRET_PARAM=

# The self-loop guard. Without these the system can ingest its own issues
# and comments, classify them, and file them again.
# Find the id: curl -s https://api.github.com/users/<app-slug>%5Bbot%5D
CIE_GITHUB_BOT_ID=0
CIE_GITHUB_BOT_LOGIN=

# --- Reddit -----------------------------------------------------------
# JSON array, not a comma-separated string — pydantic parses it as JSON.
# Leave as [] until OAuth approval comes through; the poller then no-ops.
CIE_REDDIT_SUBREDDITS=[]
CIE_REDDIT_CLIENT_ID=
CIE_REDDIT_CLIENT_SECRET=
# Reddit throttles generic user agents. Include your username.
CIE_REDDIT_USER_AGENT=python:community-intel-engine:0.1.0 (by /u/YOUR_USERNAME)

# AWS credentials are NOT read from here. They come from your normal
# chain: ~/.aws/credentials, AWS_PROFILE, or SSO.
